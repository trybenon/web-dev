# Address and port published on the host; optional, defaults work without .env.
APP_BIND=127.0.0.1
APP_PORT=3000

# For compose.release.yml / make run-release, also set:
# APP_RELEASE=<full commit SHA from git rev-parse HEAD>
# BUGSINK_DSN=https://public-key@bugsink.example/1
# BUGSINK_URL=https://bugsink.example
# BUGSINK_PROJECT=project-slug
# BUGSINK_AUTH_TOKEN=<token with debug-files upload access>
# APP_IMAGE=watch-together:release
