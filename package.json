{
  "name": "watch-together",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "2.58.6",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1"
  },
  "scripts": {
    "predev": "npm run build --workspace=shared",
    "dev": "concurrently --kill-others --names client,server \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:release": "node scripts/build-release.mjs",
    "check:release": "node scripts/check-monitoring.mjs",
    "check:release:browser": "node scripts/check-browser-monitoring.mjs",
    "test:release": "npm run build:release && npm run check:release && npm run check:release:browser",
    "upload:sourcemaps": "sh scripts/upload-bugsink-sourcemaps.sh",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"client/**/*.css\" --max-warnings=0",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "coverage": "vitest run --coverage"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
